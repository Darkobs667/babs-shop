# Utiliser impérativement l'URL pooler Neon/Supabase (port pooler), jamais une connexion directe.
DATABASE_URL=postgresql://user:password@host-pooler:5432/database?sslmode=require
AUTH_SECRET=une-cle-aleatoire-de-32-caracteres-minimum
ADMIN_EMAIL=admin@example.com
# Les $ d'un hash bcrypt doivent être échappés pour Next.js : \$2b\$12\$...
ADMIN_PASSWORD_HASH=''
# Sénégal : sans le signe +. Exemple : 221771234567
NEXT_PUBLIC_WHATSAPP_NUMBER=221771234567
UPLOADTHING_TOKEN=...
